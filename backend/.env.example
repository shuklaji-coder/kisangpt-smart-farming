# Backend environment example (copy to .env on the server)

# Local/remote Ollama server for lightweight LLM chat
# e.g. http://localhost:11434
OLLAMA_BASE_URL=
# e.g. llama3.1:8b-instruct (must be pulled in Ollama)
AI_MODEL=
# Request timeout (seconds)
AI_TIMEOUT_SECONDS=60

# NDVI tile proxy template (Sentinel Hub/GEE/your tile server)
# Use placeholders: {z}, {x}, {y}, {date}
# Example (placeholder, replace with a real, authorized endpoint):
# SATELLITE_NDVI_TILE_TEMPLATE=https://your-tiles.example/ndvi/{z}/{x}/{y}.png?date={date}&key=${SENTINEL_KEY}
SATELLITE_NDVI_TILE_TEMPLATE=
SATELLITE_PROXY_TIMEOUT=15

# CORS allowed origins (comma-separated); include your Netlify site origin
# e.g. https://your-site.netlify.app,https://localhost:3000
CORS_ORIGINS=*
